rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all for Zero-Trust baseline
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data, userId) {
      return data.userId == userId &&
        data.email is string &&
        data.email.size() <= 256;
    }

    function isValidSavedLogo(data, userId) {
      return data.userId == userId &&
        data.id is string &&
        data.id.size() <= 128 &&
        data.prompt is string &&
        data.prompt.size() <= 2000 &&
        data.base64 is string &&
        data.base64.size() <= 800000 &&
        data.mimeType is string &&
        data.mimeType.size() <= 64 &&
        data.timestamp is number;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Profiles are strictly 1:1 and private
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && incoming().userId == existing().userId && isValidUser(incoming(), userId);
      allow delete: if isOwner(userId) && isValidId(userId);

      // User saved logos subcollection
      match /savedLogos/{logoId} {
        allow get: if isOwner(userId) && isValidId(logoId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logoId) && isValidSavedLogo(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(logoId) && incoming().userId == existing().userId && isValidSavedLogo(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(logoId);
      }
    }
  }
}
